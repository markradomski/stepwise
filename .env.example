# Server-only settings. Copy to .env and fill in; never commit .env.
# Without these the app uses the deterministic explanation provider.
EXPLANATION_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000
# LLM_BASE_URL=
# EXPLANATION_PROMPT_VERSION=explanation-prompt/1

# Abuse and cost controls (defaults shown)
EXPLANATION_RATE_LIMIT_MAX=10
EXPLANATION_RATE_LIMIT_WINDOW_MS=60000
EXPLANATION_CACHE_TTL_MS=900000
EXPLANATION_CACHE_MAX_ENTRIES=200
